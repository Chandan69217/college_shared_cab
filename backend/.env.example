# ==============================================================================
# College Shared Cab & Shuttle Platform - Backend Environment Configuration
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=*

# JWT & Authentication Security
JWT_SECRET=super_secret_production_ready_jwt_signing_key_college_cab_2026
JWT_EXPIRES_IN=7d
QR_HMAC_SECRET=secure_hmac_secret_for_dynamic_qr_pass_signatures_2026

# Supabase / PostgreSQL Database Connection
# Set DATABASE_URL if connecting directly via PostgreSQL connection pooler (e.g. postgres://postgres:password@localhost:5432/postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/college_cab
# Supabase credentials (for server-side Supabase client operations)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_service_role_key

# Payment Gateway Configuration (Razorpay / Stripe / UPI)
PAYMENT_GATEWAY_PROVIDER=MOCK_RAZORPAY
RAZORPAY_KEY_ID=rzp_test_college_cab_key
RAZORPAY_KEY_SECRET=rzp_test_college_cab_secret
PAYMENT_WEBHOOK_SECRET=webhook_secret_college_cab_2026

# Google Maps / Mapbox Geocoding & Distance API
MAPS_API_KEY=dummy_maps_api_key_2026

# Push Notifications (Firebase Cloud Messaging)
FCM_SERVER_KEY=dummy_firebase_server_key

# Service Area Default Radius (km)
DEFAULT_SERVICE_RADIUS_KM=10.0
