              "path": ["auth", "register-admin"]
            }
          }
        },
        {
          "name": "Login (Student / Driver / Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "    if (json.data.user.role === 'ADMIN') {",
                  "        pm.collectionVariables.set('adminToken', json.data.token);",
                  "    } else if (json.data.user.role === 'DRIVER') {",
                  "        pm.collectionVariables.set('driverToken', json.data.token);",
                  "    } else {",
                  "        pm.collectionVariables.set('studentToken', json.data.token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"emailOrPhone\": \"admin@collegecab.com\",\n  \"password\": \"password123\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
